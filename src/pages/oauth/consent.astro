---
// OAuth 2.1 consent screen for the Splander Jobs Supabase project.
//
// Supabase Auth (OAuth server, Authorization Path "/oauth/consent") sends the
// user here as /oauth/consent?authorization_id=… when a third-party app (e.g.
// claude.ai connecting to the jobs-mcp server) asks for access. The ONLY page
// on the site with client JS: it signs the user in with Google if needed, shows
// what the app is asking for, and sends the Allow / Deny decision back to
// Supabase, which answers with the URL to return the user to the app.
//
// noindex and out of the sitemap (astro.config.mjs). Copy below is UNAPPROVED
// until Yoni signs it off.
import Base from "../../layouts/Base.astro";
import Wordmark from "../../components/Wordmark.astro";
import { SUPPORT_EMAIL, withBase } from "../../consts";

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
---

<Base
  title="Allow access"
  description="Approve or deny an app's request to access your Splander Jobs account."
  path="/oauth/consent"
  noindex={true}
  bare={true}
>
  <section class="flex min-h-screen flex-col items-center justify-center px-4 py-10 sm:px-5">
    <a href={withBase("/")} class="mb-8 rounded-control focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-coral-deep">
      <Wordmark height={22} />
    </a>

    <div
      id="consent"
      class="w-full max-w-md rounded-card border border-zinc-200 bg-white p-6 sm:p-8"
      data-supabase-url={SUPABASE_URL}
      data-supabase-anon={SUPABASE_ANON}
      data-state="loading"
    >
      <!-- loading -->
      <div data-view="loading" class="text-center">
        <p class="text-sm text-zinc-600" role="status">Checking this request…</p>
      </div>

      <!-- sign in -->
      <div data-view="signin" hidden>
        <p class="eyebrow text-coral-deep">Allow access</p>
        <h1 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-zinc-900">Sign in to continue</h1>
        <p class="mt-3 text-sm leading-relaxed text-zinc-600">
          An app wants to connect to your Splander Jobs account. Sign in with the Google account you use in the extension, then
          decide whether to allow it.
        </p>
        <button
          type="button"
          data-action="signin"
          class="mt-6 inline-flex w-full items-center justify-center gap-2 rounded-control border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-deep disabled:opacity-60"
        >
          <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.5 30.3 0 24 0 14.6 0 6.5 5.4 2.6 13.3l7.9 6.1C12.4 13.7 17.7 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.6 3-2.3 5.5-4.8 7.2l7.7 6c4.5-4.2 6.9-10.3 6.9-17.7z" />
            <path fill="#FBBC05" d="M10.5 28.6A14.5 14.5 0 0 1 9.5 24c0-1.6.3-3.1.8-4.6l-7.9-6.1A24 24 0 0 0 0 24c0 3.9.9 7.5 2.6 10.7l7.9-6.1z" />
            <path fill="#34A853" d="M24 48c6.3 0 11.8-2.1 15.6-5.8l-7.7-6c-2.1 1.4-4.8 2.3-7.9 2.3-6.3 0-11.6-4.2-13.5-9.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z" />
          </svg>
          Continue with Google
        </button>
      </div>

      <!-- consent -->
      <div data-view="consent" hidden>
        <p class="eyebrow text-coral-deep">Allow access</p>
        <h1 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-zinc-900">
          <span data-field="client-name">This app</span> wants to connect to your Splander Jobs account
        </h1>
        <p class="mt-3 text-sm text-zinc-600">
          Signed in as <strong data-field="email" class="font-semibold text-zinc-900"></strong>.
          <button type="button" data-action="switch" class="font-semibold text-coral-deep underline underline-offset-2">Not you?</button>
        </p>

        <div class="mt-6 rounded-control border border-zinc-200 bg-page p-4">
          <p class="text-xs font-semibold uppercase tracking-wide text-zinc-500">It will be able to</p>
          <ul data-field="scopes" class="mt-2 space-y-1.5 text-sm text-zinc-800"></ul>
        </div>

        <p class="mt-4 text-xs leading-relaxed text-zinc-500">
          Only allow apps you trust. After you allow, you'll be sent back to
          <span data-field="redirect-host" class="font-medium text-zinc-700"></span>. You can revoke access later from the app.
        </p>

        <div class="mt-6 grid gap-3 sm:grid-cols-2">
          <button
            type="button"
            data-action="deny"
            class="inline-flex items-center justify-center rounded-control border border-zinc-300 bg-white px-4 py-2.5 text-sm font-semibold text-zinc-900 transition-colors hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-deep disabled:opacity-60"
          >
            Deny
          </button>
          <button
            type="button"
            data-action="approve"
            class="inline-flex items-center justify-center rounded-control bg-action px-4 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-fold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-deep disabled:opacity-60"
          >
            Allow
          </button>
        </div>
      </div>

      <!-- redirecting -->
      <div data-view="redirecting" hidden class="text-center">
        <p class="text-sm text-zinc-600" role="status">Taking you back to the app…</p>
      </div>

      <!-- error -->
      <div data-view="error" hidden>
        <p class="eyebrow text-error">Something went wrong</p>
        <h1 class="mt-2 font-display text-2xl font-extrabold tracking-tight text-zinc-900">We couldn't finish this request</h1>
        <p data-field="error" class="mt-3 text-sm leading-relaxed text-zinc-600" role="alert"></p>
        <p class="mt-6 text-sm text-zinc-600">
          Go back to the app and try connecting again. Still stuck? Email
          <a href={`mailto:${SUPPORT_EMAIL}`} class="font-semibold text-coral-deep underline underline-offset-2">{SUPPORT_EMAIL}</a>.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { createClient } from "@supabase/supabase-js";

  type View = "loading" | "signin" | "consent" | "redirecting" | "error";

  // Plain-English labels for the scopes Supabase's OAuth server issues.
  const SCOPE_LABELS: Record<string, string> = {
    openid: "Confirm who you are",
    email: "See your email address",
    profile: "See your name and profile picture",
  };

  const root = document.getElementById("consent") as HTMLElement;
  const views = Object.fromEntries(
    Array.from(root.querySelectorAll<HTMLElement>("[data-view]")).map((el) => [el.dataset.view!, el]),
  ) as Record<View, HTMLElement>;
  const field = (name: string) => root.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
  const button = (name: string) => root.querySelector<HTMLButtonElement>(`[data-action="${name}"]`)!;

  function show(view: View) {
    for (const [name, el] of Object.entries(views)) el.hidden = name !== view;
    root.dataset.state = view;
  }

  function fail(message: string) {
    field("error").textContent = message;
    show("error");
  }

  function setBusy(busy: boolean) {
    for (const name of ["approve", "deny", "switch", "signin"]) button(name).disabled = busy;
  }

  // Read the id BEFORE the client initialises: on the way back from Google,
  // supabase-js exchanges ?code= and strips it from the URL (authorization_id
  // is left alone). sessionStorage is a fallback used only on that return trip,
  // so a plain visit without an id still gets the "missing id" message.
  const STORAGE_KEY = "sj-oauth-authorization-id";
  const params = new URLSearchParams(location.search);
  let authorizationId = params.get("authorization_id");
  if (authorizationId) sessionStorage.setItem(STORAGE_KEY, authorizationId);
  else if (params.has("code")) authorizationId = sessionStorage.getItem(STORAGE_KEY);

  const consentUrl = () =>
    `${location.origin}${location.pathname}?authorization_id=${encodeURIComponent(authorizationId ?? "")}`;

  async function main() {
    const supabaseUrl = root.dataset.supabaseUrl ?? "";
    const supabaseAnon = root.dataset.supabaseAnon ?? "";
    if (!supabaseUrl || !supabaseAnon) {
      fail("This page isn't configured yet. Please tell us so we can fix it.");
      return;
    }
    if (!authorizationId) {
      fail("This link is missing its authorization id, so there's nothing to approve.");
      return;
    }
    const id = authorizationId;

    const supabase = createClient(supabaseUrl, supabaseAnon);

    // Google round-trip failed (user cancelled, provider error…) — Supabase puts
    // the reason in the URL.
    const oauthError = params.get("error_description") || params.get("error");
    if (oauthError && !params.get("code")) {
      fail(`Sign-in didn't finish: ${oauthError}.`);
      return;
    }

    const {
      data: { session },
      error: sessionError,
    } = await supabase.auth.getSession();
    if (sessionError) {
      fail(`Sign-in didn't finish: ${sessionError.message}.`);
      return;
    }

    button("signin").addEventListener("click", async () => {
      setBusy(true);
      const { error } = await supabase.auth.signInWithOAuth({
        provider: "google",
        options: { redirectTo: consentUrl() },
      });
      if (error) {
        setBusy(false);
        fail(`Sign-in didn't start: ${error.message}.`);
      }
    });

    button("switch").addEventListener("click", async () => {
      setBusy(true);
      await supabase.auth.signOut();
      setBusy(false);
      show("signin");
    });

    if (!session) {
      show("signin");
      return;
    }

    const { data, error } = await supabase.auth.oauth.getAuthorizationDetails(id);
    if (error) {
      if (error.status === 401 || error.status === 403) {
        // Stale or revoked local session: ask for a fresh sign-in.
        await supabase.auth.signOut();
        show("signin");
        return;
      }
      // Expired, already used, or unknown id.
      fail(`This request has expired or is no longer valid (${error.message}).`);
      return;
    }
    if (!("authorization_id" in data)) {
      // Already consented to these scopes: straight back to the app.
      show("redirecting");
      location.href = data.redirect_url;
      return;
    }

    field("client-name").textContent = data.client.name || "An app";
    field("email").textContent = data.user.email;
    try {
      field("redirect-host").textContent = new URL(data.redirect_uri).host;
    } catch {
      field("redirect-host").textContent = data.redirect_uri;
    }
    const scopes = data.scope.split(/\s+/).filter(Boolean);
    const list = field("scopes");
    list.replaceChildren(
      ...(scopes.length ? scopes : ["(no specific permissions requested)"]).map((s) => {
        const li = document.createElement("li");
        li.className = "flex gap-2";
        li.innerHTML = `<span aria-hidden="true" class="text-success">✓</span>`;
        li.append(document.createTextNode(SCOPE_LABELS[s] ?? s));
        return li;
      }),
    );
    show("consent");

    const decide = (approve: boolean) => async () => {
      setBusy(true);
      const api = supabase.auth.oauth;
      const { data: result, error: decideError } = approve
        ? await api.approveAuthorization(id, { skipBrowserRedirect: true })
        : await api.denyAuthorization(id, { skipBrowserRedirect: true });
      if (decideError) {
        setBusy(false);
        fail(`We couldn't record your choice (${decideError.message}).`);
        return;
      }
      sessionStorage.removeItem(STORAGE_KEY);
      show("redirecting");
      location.href = result.redirect_url;
    };
    button("approve").addEventListener("click", decide(true));
    button("deny").addEventListener("click", decide(false));
  }

  main().catch((err: unknown) => {
    fail(`Unexpected error: ${err instanceof Error ? err.message : String(err)}.`);
  });
</script>
