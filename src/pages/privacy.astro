---
import Base from "../layouts/Base.astro";
import { SUPPORT_EMAIL } from "../consts";
// The policy text has ONE source: PRIVACY.md at the root of splander-com/jobs,
// the file the Chrome Web Store listing relies on. src/content/privacy.md is a
// verbatim copy of it — refresh the copy whenever PRIVACY.md changes (see
// README). Never hand-edit the policy here: a hand-kept copy drifted for months.
import * as policy from "../content/privacy.md";

const raw = policy.rawContent();
const updated = raw.match(/_Last updated:\s*(\d{4}-\d{2}-\d{2})_/)?.[1];
if (!updated) throw new Error("src/content/privacy.md: missing the '_Last updated: YYYY-MM-DD_' line");

// The page renders its own title + date header, so drop the file's <h1> and
// its date line. Support addresses written as `code` become mailto links.
const html = (await policy.compiledContent())
  .replace(/<h1[^>]*>[\s\S]*?<\/h1>/, "")
  .replace(/<p><em>Last updated:[\s\S]*?<\/em><\/p>/, "")
  .replaceAll(`<code>${SUPPORT_EMAIL}</code>`, `<a href="mailto:${SUPPORT_EMAIL}">${SUPPORT_EMAIL}</a>`);
---

<Base
  title="Privacy Policy"
  description="Exactly what Splander Jobs handles, where it lives, and what we do (and don't do) with it. Private by default: your job search stays in your browser unless you sign in to sync."
  path="/privacy"
>
  <section class="bg-page">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-5">
      <p class="eyebrow text-coral-deep">Legal</p>
      <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight text-zinc-900">Privacy Policy</h1>
      <p class="mt-3 text-sm text-zinc-600">Last updated: <time datetime={updated}>{updated}</time></p>

      <div class="prose-sj mt-8">
        <Fragment set:html={html} />

        <h2>This website</h2>
        <p>This section covers jobs.splander.com, not the extension.</p>
        <ul>
          <li><strong>No cookies, no analytics, no ads.</strong> This site sets no cookies and runs no analytics or advertising scripts.</li>
          <li>
            <strong>The feedback form sends only when you press Send.</strong> It sends your message, an optional
            star rating, your browser's language, and a random id stored in your browser's localStorage
            (<code>sj_fb_install</code>). The id isn't linked to your name or email.
          </li>
          <li><strong>Your email is optional.</strong> If you add it, we store it so we can reply and send you product updates.</li>
          <li>
            <strong>Deleting your feedback.</strong> Email <a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a> and
            we'll delete your feedback and your email.
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>
