---
// Post-uninstall survey. The extension opens it on removal
// (chrome.runtime.setUninstallURL) as /uninstall?iid=<install_id>&v=<version>,
// and the old splander-com.github.io/jobtrail-privacy/uninstall URL redirects
// here with the same query. POSTs to the Supabase `submit-feedback` function as
// category/source "uninstall"; the reasons travel as whitelisted codes (the
// function drops anything else). noindex and kept out of the sitemap.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Mascot from "../components/Mascot.astro";
import { CHROME_STORE_URL, SUPPORT_EMAIL, withBase } from "../consts";

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
const SUPABASE_ANON = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
const endpoint = SUPABASE_URL ? `${SUPABASE_URL}/functions/v1/submit-feedback` : "";

// Codes must match UNINSTALL_REASONS in jobs/supabase/functions/submit-feedback
// and REASON_LABELS in jobs-admin.
const reasons = [
  { code: "site_not_supported", label: "It didn't work on a job site I use" },
  { code: "missing_feature", label: "A feature I need is missing" },
  { code: "too_complicated", label: "Too complicated to set up or use" },
  { code: "bugs", label: "Bugs or it was slow" },
  { code: "privacy", label: "Privacy concerns" },
  { code: "found_job", label: "I found a job 🎉" },
  { code: "other_tool", label: "I'm using another tool" },
  { code: "other", label: "Something else" },
];
---

<Base
  title="Sorry to see you go"
  description="Tell us why you removed Splander Jobs, so we can make it better."
  path="/uninstall"
  noindex={true}
>
  <section class="bg-chrome text-white">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-5 px-4 py-12 text-center sm:px-5 lg:py-14">
      <Mascot on="dark" width={120} />
      <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-5xl">Sorry to see you go</h1>
      <p class="max-w-xl text-lg text-zinc-300">Splander Jobs is removed. Tell us why in one tap, and we'll use it to make the extension better.</p>
    </div>
  </section>

  <Section tone="page" class="[&>div]:py-12 sm:[&>div]:py-14">
    <div class="mx-auto max-w-2xl">
      <form
        id="uninstall-form"
        class="rounded-card border border-zinc-200 bg-white p-6 sm:p-8"
        data-endpoint={endpoint}
        data-anon={SUPABASE_ANON}
        novalidate
      >
        <fieldset>
          <legend class="text-sm font-semibold text-zinc-900">Why did you remove it? <span class="font-normal text-zinc-600">(pick any)</span></legend>
          <div class="mt-3 grid gap-2 sm:grid-cols-2">
            {
              reasons.map((r) => (
                <button
                  type="button"
                  class="un-reason rounded-control border border-zinc-300 px-4 py-3 text-left text-sm text-zinc-800 transition-colors hover:border-coral-deep aria-pressed:border-coral-deep aria-pressed:bg-paper aria-pressed:font-semibold aria-pressed:text-zinc-900"
                  data-code={r.code}
                  aria-pressed="false"
                >
                  {r.label}
                </button>
              ))
            }
          </div>
        </fieldset>

        <div class="mt-6">
          <label for="un-message" class="block text-sm font-semibold text-zinc-900">Anything else? <span class="font-normal text-zinc-600">(optional)</span></label>
          <textarea id="un-message" name="message" rows="4" maxlength="4000"
            class="mt-2 w-full rounded-control border border-zinc-300 px-4 py-3 text-sm outline-none focus:border-coral-deep focus:ring-2 focus:ring-action/30"
            placeholder="Which site, which feature, what went wrong…"></textarea>
        </div>

        <!-- Honeypot: hidden from humans, bots fill it. -->
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label for="un-company">Company</label>
          <input id="un-company" name="company" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <button type="submit" id="un-submit"
            class="inline-flex items-center justify-center gap-2 rounded-control bg-action px-6 py-3 text-sm font-semibold text-ink transition-colors hover:bg-fold focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-coral-deep disabled:cursor-not-allowed disabled:opacity-60">
            Send
          </button>
          <p id="un-status" class="text-sm" role="status" aria-live="polite"></p>
        </div>

        <p class="mt-6 text-xs leading-relaxed text-zinc-600">
          We receive only what you pick and type, the extension version and your browser's language.
          No email, no tracking. <a href={withBase("/privacy")} class="underline underline-offset-2">Privacy policy</a>
        </p>
      </form>

      <div id="un-thanks" class="hidden rounded-card border border-zinc-200 bg-white p-6 text-center sm:p-8" tabindex="-1">
        <h2 class="font-display text-2xl font-extrabold text-zinc-900">Thanks, we got it</h2>
        <p class="mt-2 text-sm text-zinc-600">We read every answer. If you change your mind, Splander Jobs is one click away.</p>
      </div>

      <p class="mt-6 text-center text-sm text-zinc-600">
        Removed it by mistake?
        <a href={CHROME_STORE_URL} target="_blank" rel="noopener" class="font-semibold text-coral-deep underline underline-offset-2">Install it again</a>
        · Questions? <a href={`mailto:${SUPPORT_EMAIL}`} class="font-semibold text-coral-deep underline underline-offset-2">{SUPPORT_EMAIL}</a>
      </p>
    </div>
  </Section>
</Base>

<script is:inline>
  (function () {
    const form = document.getElementById("uninstall-form");
    if (!form) return;
    const statusEl = document.getElementById("un-status");
    const submitBtn = document.getElementById("un-submit");
    const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    const params = new URLSearchParams(location.search);

    document.querySelectorAll(".un-reason").forEach(function (btn) {
      btn.addEventListener("click", function () {
        const on = btn.getAttribute("aria-pressed") !== "true";
        btn.setAttribute("aria-pressed", on ? "true" : "false");
      });
    });

    function setStatus(msg, ok) {
      statusEl.textContent = msg;
      statusEl.className = "text-sm " + (ok ? "text-green-800" : "text-red-700");
    }

    // The extension passes its anonymous install id, so the answer links to the
    // same install as its telemetry. Without one (a shared or hand-typed link)
    // fall back to the website's per-visitor id, same as the /feedback form.
    function installId() {
      const iid = params.get("iid");
      if (iid && UUID_RE.test(iid)) return iid;
      try {
        let id = localStorage.getItem("sj_fb_install");
        if (!id) {
          id = crypto.randomUUID();
          localStorage.setItem("sj_fb_install", id);
        }
        return id;
      } catch (_) {
        return crypto.randomUUID();
      }
    }

    function showThanks() {
      form.classList.add("hidden");
      const thanks = document.getElementById("un-thanks");
      thanks.classList.remove("hidden");
      thanks.focus();
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      const endpoint = form.getAttribute("data-endpoint");
      const anon = form.getAttribute("data-anon");
      const message = form.querySelector("#un-message").value.trim();
      const reasons = Array.from(document.querySelectorAll('.un-reason[aria-pressed="true"]')).map(function (b) {
        return b.getAttribute("data-code");
      });

      // Honeypot: a filled hidden field means a bot — fake success, send nothing.
      if (form.querySelector("#un-company").value) {
        showThanks();
        return;
      }
      if (!reasons.length && !message) {
        setStatus("Pick a reason or write a few words first.", false);
        return;
      }
      if (!endpoint || !anon) {
        setStatus("This form isn't configured yet. Email dev@splander.com instead.", false);
        return;
      }
      submitBtn.disabled = true;
      setStatus("Sending…", true);
      try {
        const res = await fetch(endpoint, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            apikey: anon,
            Authorization: "Bearer " + anon,
          },
          body: JSON.stringify({
            install_id: installId(),
            category: "uninstall",
            source: "uninstall",
            reasons: reasons,
            message: message || undefined,
            app_version: (params.get("v") || "").slice(0, 32) || null,
            platform: "web",
            locale: navigator.language || null,
          }),
        });
        if (!res.ok) throw new Error("bad status " + res.status);
        showThanks();
      } catch (err) {
        setStatus("Something went wrong. Please try again or email dev@splander.com.", false);
        submitBtn.disabled = false;
      }
    });
  })();
</script>
