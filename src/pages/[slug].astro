---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CtaButton from "../components/CtaButton.astro";
import ChromeGlyph from "../components/ChromeGlyph.astro";
import ScreenshotFrame from "../components/ScreenshotFrame.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatusLegend from "../components/StatusLegend.astro";
import Moment from "../components/Moment.astro";
import Mascot from "../components/Mascot.astro";
import { JOURNEYS, getJourney } from "../data/journeys";
import { SITE_URL, withBase } from "../consts";

export function getStaticPaths() {
  return JOURNEYS.map((j) => ({ params: { slug: j.slug } }));
}

const { slug } = Astro.params;
const j = getJourney(slug!)!;
const idx = JOURNEYS.findIndex((x) => x.slug === slug);
const prev = idx > 0 ? JOURNEYS[idx - 1] : null;
const next = idx < JOURNEYS.length - 1 ? JOURNEYS[idx + 1] : null;

// Features with their own visual (a moment or the status legend) get a full
// row; the rest sit together as cards.
const rows = j.features.filter((f) => f.moment || f.statusLegend);
const cards = j.features.filter((f) => !f.moment && !f.statusLegend);

const origin = SITE_URL.replace(/\/$/, "");
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: j.faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: origin },
    { "@type": "ListItem", position: 2, name: j.nav, item: `${origin}${withBase(j.slug)}` },
  ],
};
---

<Base title={j.metaTitle} description={j.metaDescription} path={`/${j.slug}`} jsonLd={[faqLd, breadcrumbLd]}>
  <!-- HERO — the page's one chrome band -->
  <section class="bg-chrome text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-5 lg:grid-cols-2 lg:py-24">
      <div>
        <p class="eyebrow text-action">{j.eyebrow}</p>
        <h1 class="mt-4 font-display text-4xl font-extrabold leading-[1.08] tracking-tight sm:text-5xl">{j.title}</h1>
        <p class="mt-5 max-w-lg text-lg leading-relaxed text-zinc-300">{j.subtitle}</p>
        <div class="mt-8">
          <CtaButton size="lg">
            <ChromeGlyph slot="icon" size={20} />
            Add to Chrome — it's free
          </CtaButton>
        </div>
      </div>
      {
        j.heroShot ? (
          <ScreenshotFrame src={j.heroShot.src} alt={j.heroShot.alt} priority />
        ) : (
          <Mascot on="dark" width={360} class="mx-auto h-auto max-w-full" />
        )
      }
    </div>
  </section>

  <!-- INTRO -->
  <Section tone="page">
    <p class="mx-auto max-w-3xl text-center text-xl leading-relaxed text-zinc-700">{j.intro}</p>
  </Section>

  <!-- FEATURES -->
  <Section tone="white">
    {
      rows.length > 0 && (
        <div class="space-y-12">
          {rows.map((f) => (
            <div class="grid items-center gap-8 rounded-card border border-zinc-200 bg-page p-6 sm:p-8 lg:grid-cols-[1fr_auto]">
              <div>
                <h2 class="font-display text-2xl font-extrabold text-zinc-900 sm:text-3xl">{f.title}</h2>
                <p class="mt-3 max-w-2xl text-base leading-relaxed text-zinc-600">{f.body}</p>
                {f.statusLegend && <div class="mt-5"><StatusLegend /></div>}
              </div>
              {f.moment && (
                <figure class="justify-self-center">
                  <Moment name={f.moment} width={240} />
                  {f.momentCaption && (
                    <figcaption class="mt-2 text-center text-sm font-semibold text-zinc-700">{f.momentCaption}</figcaption>
                  )}
                </figure>
              )}
            </div>
          ))}
        </div>
      )
    }
    {
      cards.length > 0 && (
        <div class:list={["grid gap-4 sm:grid-cols-2", cards.length === 3 && "lg:grid-cols-3", rows.length > 0 && "mt-12"]}>
          {cards.map((f) => (
            <FeatureCard title={f.title}>{f.body}</FeatureCard>
          ))}
        </div>
      )
    }
    <p class="mt-10 text-center text-sm text-zinc-600">The interface is available in English and Hebrew.</p>
  </Section>

  <!-- FAQ -->
  <Section tone="page">
    <div class="mx-auto max-w-3xl">
      <h2 class="font-display text-3xl font-extrabold text-zinc-900">Questions, answered</h2>
      <dl class="mt-8 divide-y divide-zinc-200">
        {
          j.faqs.map((f) => (
            <div class="py-5">
              <dt class="font-semibold text-zinc-900">{f.q}</dt>
              <dd class="mt-2 text-zinc-600">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- PREV / NEXT -->
  <Section tone="white">
    <nav class="grid gap-4 sm:grid-cols-2" aria-label="More features">
      {
        prev ? (
          <a href={withBase(prev.slug)} class="rounded-card border border-zinc-200 bg-white p-6 transition-colors hover:border-zinc-400">
            <span class="eyebrow text-zinc-600">← Previous · {prev.nav}</span>
            <span class="mt-2 block font-display text-lg font-bold text-zinc-900">{prev.title}</span>
          </a>
        ) : (
          <div class="hidden sm:block" />
        )
      }
      {
        next && (
          <a href={withBase(next.slug)} class="rounded-card border border-zinc-200 bg-white p-6 text-right transition-colors hover:border-zinc-400 sm:col-start-2">
            <span class="eyebrow text-coral-deep">Next · {next.nav} →</span>
            <span class="mt-2 block font-display text-lg font-bold text-zinc-900">{next.title}</span>
          </a>
        )
      }
    </nav>
  </Section>

  <!-- CLOSING BAND (light) -->
  <Section tone="paper">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-display text-3xl font-extrabold text-zinc-900 sm:text-4xl">Your job search co-pilot.</h2>
      <p class="mx-auto mt-4 max-w-xl text-lg text-zinc-600">Free, and private by default. Set up in a minute.</p>
      <div class="mt-8 flex justify-center">
        <CtaButton size="lg">
          <ChromeGlyph slot="icon" size={20} />
          Add to Chrome
        </CtaButton>
      </div>
    </div>
  </Section>
</Base>
