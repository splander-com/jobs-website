---
// Post-install landing page. The extension opens it as
// /welcome?utm_source=extension&utm_medium=install. Static, no client JS, and
// noindex (kept out of the sitemap in astro.config.mjs). The canonical drops
// the query string; the utm params stay on the request URL untouched.
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import FeatureCard from "../components/FeatureCard.astro";
import Mascot from "../components/Mascot.astro";
import Mark from "../components/Mark.astro";
import { CHROME_STORE_URL, JOB_SITES_TEXT, withBase } from "../consts";

const values = [
  {
    title: "Get job ready",
    body: "We check your CV and LinkedIn profile and show you what to improve, so you're ready to start applying.",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6Zm-1 7V3.5L18.5 9H13Zm-2.3 9.3-3.2-3.2 1.4-1.4 1.8 1.8 4.3-4.3 1.4 1.4-5.7 5.7Z",
  },
  {
    title: "Apply faster",
    body: "We autofill application forms with your details and CV. You review and submit.",
    icon: "M13 2 4 14h7l-1 8 9-12h-7l1-8Z",
  },
  {
    title: "Every application, in one list",
    body: "Every job you save is kept on your computer with its status. Connect Gmail and the statuses update on their own.",
    icon: "M4 5h2v2H4V5Zm4 0h12v2H8V5Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Zm-4 6h2v2H4v-2Zm4 0h12v2H8v-2Z",
  },
];

const steps = [
  {
    t: "Pin Splander Jobs to your toolbar.",
    d: "Click the puzzle icon in Chrome's toolbar, then the pin next to Splander Jobs.",
  },
  {
    t: "Open the side panel.",
    d: "Click the Splander Jobs icon. The panel opens on Get Job Ready.",
  },
  {
    t: "Add your CV and LinkedIn profile.",
    d: "Upload your CV and import your LinkedIn profile to see your score and your next steps.",
  },
  {
    t: "Save your first job.",
    // Gmail step left out while Gmail is a closed beta (GmailBetaGate in the
    // extension): most store installers can't connect it yet.
    d: `Open a job on ${JOB_SITES_TEXT} and press Save.`,
  },
];
---

<Base
  title="Welcome"
  description="You've installed Splander Jobs. Here's what it does for you and how to set it up in four steps."
  path="/welcome"
  noindex={true}
>
  <!-- HERO — the page's one chrome band -->
  <section class="bg-chrome text-white">
    <div class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-12 text-center sm:px-5 lg:py-16">
      <Mascot on="dark" width={160} />
      <div>
        <p class="eyebrow text-action">Splander Jobs is installed</p>
        <h1 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-5xl">
          You're in. Here's what Splander Jobs does for you.
        </h1>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <Section tone="page" class="[&>div]:py-12 sm:[&>div]:py-14">
    <div class="grid gap-4 md:grid-cols-3">
      {
        values.map((v) => (
          <FeatureCard title={v.title}>
            <svg slot="icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d={v.icon} />
            </svg>
            {v.body}
          </FeatureCard>
        ))
      }
    </div>
  </Section>

  <!-- SETUP CHECKLIST -->
  <Section tone="white" class="[&>div]:py-12 sm:[&>div]:py-14">
    <div class="mx-auto max-w-2xl">
      <p class="eyebrow text-coral-deep">Setup</p>
      <h2 class="mt-2 font-display text-3xl font-extrabold text-zinc-900 sm:text-4xl">Get started in 4 steps</h2>
      <ol class="mt-8 space-y-6">
        {
          steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="tnum grid h-9 w-9 shrink-0 place-items-center rounded-full bg-signal font-display font-bold text-ink" aria-hidden="true">
                {i + 1}
              </span>
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold text-zinc-900">
                  <span class="sr-only">Step {i + 1}: </span>
                  {s.t}
                </h3>
                <p class="mt-1 text-sm text-zinc-600">{s.d}</p>
                {i === 0 && (
                  /* Illustration of Chrome's extensions menu: the puzzle icon,
                     and the Splander Jobs row with its pin highlighted. */
                  <div class="mt-4 max-w-sm overflow-hidden rounded-card border border-zinc-200 bg-zinc-50" aria-hidden="true">
                    <div class="flex items-center justify-end gap-3 border-b border-zinc-200 bg-zinc-100 px-3 py-2">
                      <span class="h-2 flex-1 rounded-full bg-zinc-200" />
                      <span class="grid h-7 w-7 place-items-center rounded-full bg-white text-zinc-700 ring-2 ring-action">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M20.5 11H19V7a2 2 0 0 0-2-2h-4V3.5a2.5 2.5 0 0 0-5 0V5H4a2 2 0 0 0-2 2v3.8h1.5a2.7 2.7 0 0 1 0 5.4H2V20a2 2 0 0 0 2 2h3.8v-1.5a2.7 2.7 0 0 1 5.4 0V22H17a2 2 0 0 0 2-2v-4h1.5a2.5 2.5 0 0 0 0-5Z" />
                        </svg>
                      </span>
                      <span class="h-5 w-5 rounded-full bg-zinc-300" />
                    </div>
                    <div class="p-3">
                      <p class="eyebrow text-zinc-500">Extensions</p>
                      <div class="mt-2 flex items-center gap-3 rounded-control bg-white px-3 py-2 ring-1 ring-zinc-200">
                        <Mark size={16} />
                        <span class="flex-1 text-sm font-semibold text-zinc-900">Splander Jobs</span>
                        <span class="grid h-7 w-7 place-items-center rounded-full bg-paper text-coral-deep ring-2 ring-action">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M16 3v2h-1v6l2 3v2h-4v6l-1 1-1-1v-6H7v-2l2-3V5H8V3h8Z" />
                          </svg>
                        </span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <!-- PRIVACY NOTE + LINKS -->
  <Section tone="page" class="[&>div]:py-10">
    <div class="mx-auto flex max-w-2xl flex-col items-center gap-4 text-center">
      <p class="flex items-start gap-2 text-sm text-zinc-600 sm:items-center">
        <svg class="mt-0.5 shrink-0 text-coral-deep sm:mt-0" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1 3 5v6c0 5 3.8 9.7 9 11 5.2-1.3 9-6 9-11V5l-9-4Zm-1 15-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6Z"/></svg>
        <span>
          Your jobs are saved on your computer, and your emails are read there and never uploaded.
          <a href={withBase("/privacy")} class="font-semibold text-coral-deep underline underline-offset-2">How we handle your data</a>
        </span>
      </p>
      <ul class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
        <li><a href={withBase("/feedback")} class="text-coral-deep hover:underline">Share feedback</a></li>
        <li><a href={CHROME_STORE_URL} target="_blank" rel="noopener" class="text-coral-deep hover:underline">Splander Jobs on the Chrome Web Store</a></li>
      </ul>
    </div>
  </Section>
</Base>
