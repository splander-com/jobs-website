---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import CtaButton from "../components/CtaButton.astro";
import ChromeGlyph from "../components/ChromeGlyph.astro";

// Cloud sync is FREE for signed-in users; Premium = AI features via the waitlist.
const free = [
  "A status pill on every job card on 7 job sites",
  "Side-panel tracker with notes, salary terms and status history",
  "Gmail status updates (optional, read-only, read on your device)",
  "CV match on your device, and up to 10 CVs",
  "LinkedIn profile import and profile score",
  "Autofill for application forms",
  "Recruiter contacts and follow-up templates",
  "Daily and weekly CV goal, streak and insights",
  "Cloud sync across devices (sign in)",
];
const premium = ["Everything in Free", "AI CV match", "Resume tailoring for each job", "AI-drafted recruiter outreach"];
---

<Base
  title="Premium"
  description="Splander Jobs is free, including cloud sync when you sign in. Premium adds AI CV match, resume tailoring and AI-drafted recruiter outreach. Join the waitlist inside the extension."
  path="/premium"
>
  <section class="bg-chrome text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-5 lg:py-20">
      <p class="eyebrow text-action">Waitlist open</p>
      <h1 class="mt-4 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Free to use. Premium adds AI.</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-zinc-300">
        Tracking, status pills, Gmail updates, the CV match, autofill, goals and cloud sync are all free. Premium adds AI
        features on top.
      </p>
    </div>
  </section>

  <Section tone="page">
    <div class="grid gap-6 lg:grid-cols-2">
      <div class="rounded-card border border-zinc-200 bg-white p-6 sm:p-8">
        <h2 class="font-display text-2xl font-extrabold text-zinc-900">Free</h2>
        <p class="mt-1 text-sm text-zinc-600">Everything you need to run your job search.</p>
        <ul class="mt-6 space-y-3">
          {
            free.map((f) => (
              <li class="flex items-start gap-3 text-sm text-zinc-700">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 shrink-0 text-coral-deep" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.1 3.1 6.8-6.8a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
                {f}
              </li>
            ))
          }
        </ul>
        <CtaButton size="lg" class="mt-8 w-full">
          <ChromeGlyph slot="icon" size={20} />
          Add to Chrome
        </CtaButton>
      </div>

      <div class="relative rounded-card border-2 border-action bg-white p-6 sm:p-8">
        <span class="absolute -top-3 left-6 rounded-full bg-signal px-3 py-1 text-xs font-bold text-ink sm:left-8">Coming soon</span>
        <h2 class="font-display text-2xl font-extrabold text-zinc-900">Premium</h2>
        <p class="mt-1 text-sm text-zinc-600">Everything in Free, plus AI.</p>
        <ul class="mt-6 space-y-3">
          {
            premium.map((f) => (
              <li class="flex items-start gap-3 text-sm text-zinc-700">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 shrink-0 text-coral-deep" aria-hidden="true"><path d="M10 1l1.8 4.9L17 7l-4.2 2.4L12 15l-2-4-2 4-.8-5.6L3 7l5.2-1.1L10 1z"/></svg>
                {f}
              </li>
            ))
          }
        </ul>
        <div class="mt-8 rounded-control bg-paper p-4 text-sm text-zinc-700">
          Join the waitlist from the <span class="font-semibold text-zinc-900">Premium</span> tab inside the extension.
          There's no commitment, and you'll get first access when the AI features open.
        </div>
      </div>
    </div>
    <p class="mt-8 text-center text-sm text-zinc-600">
      Signing in is optional. It turns on free cloud sync across your devices, which you can turn off in Settings.
      Tracking works without an account.
    </p>
  </Section>
</Base>
