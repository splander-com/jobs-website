---
import Base from "../layouts/Base.astro";
import CtaButton from "../components/CtaButton.astro";
import Mascot from "../components/Mascot.astro";
import { JOURNEYS } from "../data/journeys";
import { withBase } from "../consts";
---

<Base title="Page not found" description="This page doesn't exist." noindex={true}>
  <section class="bg-chrome text-white">
    <div class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-5">
      <Mascot on="dark" width={220} class="mx-auto" />
      <p class="tnum mt-4 font-display text-5xl font-extrabold text-action">404</p>
      <h1 class="mt-3 font-display text-3xl font-extrabold">This page doesn't exist.</h1>
      <p class="mt-3 text-zinc-300">Let's get you back to your job search.</p>
      <div class="mt-8 flex justify-center">
        <CtaButton href="/" variant="ghost-light" size="lg" external={false}>Back to home</CtaButton>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-2 text-sm">
        {
          JOURNEYS.map((j) => (
            <a href={withBase(j.slug)} class="rounded-full bg-white/10 px-3 py-1 text-zinc-200 ring-1 ring-white/15 transition-colors hover:bg-white/15">{j.nav}</a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
