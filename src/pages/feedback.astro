---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import FeedbackForm from "../components/FeedbackForm.astro";
import { SUPPORT_EMAIL } from "../consts";
---

<Base
  title="Share feedback"
  description="Tell the Splander Jobs team what's working, what's missing, or what broke. We read every message."
  path="/feedback"
>
  <section class="bg-chrome text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-5 lg:py-20">
      <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">We read every message</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-zinc-300">A bug, a missing feature, or an idea. Tell us. We read every message.</p>
    </div>
  </section>

  <Section tone="page">
    <div class="mx-auto max-w-2xl">
      <FeedbackForm />
      <p class="mt-6 text-center text-sm text-zinc-600">
        Prefer email? Reach us at <a href={`mailto:${SUPPORT_EMAIL}`} class="font-semibold text-coral-deep underline underline-offset-2">{SUPPORT_EMAIL}</a>.
      </p>
    </div>
  </Section>
</Base>
