---
import Lockup from "./Lockup.astro";
import { JOURNEY, SUPPORT_EMAIL, SPLANDER_HOME, CHROME_STORE_URL, JOB_SITES_TEXT, withBase } from "../consts";
---

<footer class="bg-chrome text-zinc-300">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:grid-cols-2 sm:px-5 lg:grid-cols-4">
    <div class="lg:col-span-1">
      <Lockup variant="black" width={210} class="-ml-3" />
      <p class="mt-2 max-w-xs text-sm leading-relaxed text-zinc-400">
        Your job search co-pilot. Free to use, no account needed. Sign in only if you want free sync across devices.
      </p>
    </div>

    <div>
      <h2 class="eyebrow text-zinc-400">Features</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {JOURNEY.map((j) => <li><a href={withBase(j.slug)} class="transition-colors hover:text-white">{j.nav}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-zinc-400">Product</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={CHROME_STORE_URL} target="_blank" rel="noopener" class="transition-colors hover:text-white">Add to Chrome</a></li>
        <li><a href={withBase("/premium")} class="transition-colors hover:text-white">Premium</a></li>
        <li><a href={withBase("/feedback")} class="transition-colors hover:text-white">Feedback</a></li>
        <li><a href={withBase("/privacy")} class="transition-colors hover:text-white">Privacy</a></li>
      </ul>
    </div>

    <div>
      <h2 class="eyebrow text-zinc-400">Splander</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={SPLANDER_HOME} target="_blank" rel="noopener" class="transition-colors hover:text-white">splander.com</a></li>
        <li><a href={`mailto:${SUPPORT_EMAIL}`} class="transition-colors hover:text-white">{SUPPORT_EMAIL}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-zinc-400 sm:flex-row sm:items-start sm:justify-between sm:px-5">
      <p class="shrink-0">© {new Date().getFullYear()} Splander. Part of the Splander family.</p>
      <p class="max-w-xl">
        Independent tool. Not affiliated with, endorsed by or sponsored by {JOB_SITES_TEXT.replace(" and ", ", ")}, Google or
        any applicant-tracking system named on this site. All trademarks belong to their respective owners.
      </p>
    </div>
  </div>
</footer>
