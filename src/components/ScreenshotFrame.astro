---
/*
 * Marketing frame around a real 1280×800 store screenshot (public/screens).
 * The frame is the only element that carries a shadow (`shadow-frame`).
 */
import { withBase } from "../consts";

interface Props {
  src: string;
  alt: string;
  /** Above the fold: load eagerly with high priority. */
  priority?: boolean;
  class?: string;
}
const { src, alt, priority = false, class: cls = "" } = Astro.props;
---

<figure class={`overflow-hidden rounded-frame border border-zinc-200 bg-white shadow-frame ${cls}`}>
  <img
    src={withBase(src)}
    alt={alt}
    width="1280"
    height="800"
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : undefined}
    decoding="async"
    class="block h-auto w-full"
  />
</figure>
