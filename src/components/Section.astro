---
interface Props {
  id?: string;
  /** page = neutral #F6F4F5, white, paper = light coral tint. One chrome hero
   *  per page lives in the page itself, not here. */
  tone?: "page" | "white" | "paper";
  class?: string;
  width?: "default" | "wide";
}
const { id, tone = "page", class: cls = "", width = "default" } = Astro.props;
const tones = {
  page: "bg-page text-zinc-800",
  white: "bg-white text-zinc-800",
  paper: "bg-paper text-zinc-800",
};
const max = width === "wide" ? "max-w-7xl" : "max-w-6xl";
---
<section id={id} class={`${tones[tone]} ${cls}`}>
  <div class={`mx-auto ${max} px-4 py-16 sm:px-5 sm:py-20`}>
    <slot />
  </div>
</section>
