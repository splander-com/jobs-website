---
/*
 * Status pill in the extension's seven meaning tones (STATUS_TONES in
 * extension/lib/types.ts): tint background + tint text, all AA. Status colours
 * are not brand colours; spark/coral are never used here.
 */
export type Tone = "sent" | "received" | "interview" | "offer" | "hold" | "rejected" | "neutral";

interface Props {
  label: string;
  tone: Tone;
}
const { label, tone } = Astro.props;
const tones: Record<Tone, string> = {
  sent: "bg-status-sent-bg text-status-sent-fg",
  received: "bg-status-received-bg text-status-received-fg",
  interview: "bg-status-interview-bg text-status-interview-fg",
  offer: "bg-status-offer-bg text-status-offer-fg",
  hold: "bg-status-hold-bg text-status-hold-fg",
  rejected: "bg-status-rejected-bg text-status-rejected-fg",
  neutral: "bg-status-neutral-bg text-status-neutral-fg",
};
---

<span class={`inline-flex items-center rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.5px] ${tones[tone]}`}>
  {label}
</span>
