---
import { CHROME_STORE_URL, withBase } from "../consts";

interface Props {
  href?: string;
  /** primary = the one coral action; ghost = on light; ghost-light = on chrome. */
  variant?: "primary" | "ghost" | "ghost-light";
  size?: "md" | "lg";
  external?: boolean;
  class?: string;
}

const {
  href = CHROME_STORE_URL,
  variant = "primary",
  size = "md",
  external = true,
  class: cls = "",
} = Astro.props;

// Base-prefix internal root-relative links ("/feedback", "/"); leave external
// URLs and in-page hash links untouched.
const isInternal = href.startsWith("/") && !href.startsWith("//");
const resolvedHref = isInternal ? withBase(href) : href;

const base =
  "inline-flex items-center justify-center gap-2 rounded-control font-semibold transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2";
const sizes = { md: "px-4 py-2.5 text-sm", lg: "px-6 py-3.5 text-base" };
const variants = {
  // Coral fill, ink label (5.9:1). Never a white label on coral (2.6:1).
  primary: "bg-action text-ink hover:bg-fold focus-visible:outline-coral-deep",
  ghost: "bg-white text-zinc-900 border border-zinc-300 hover:border-zinc-400 focus-visible:outline-coral-deep",
  "ghost-light": "bg-white/10 text-white border border-white/25 hover:bg-white/15 focus-visible:outline-action",
};
const rel = external ? "noopener" : undefined;
const target = external ? "_blank" : undefined;
---

<a href={resolvedHref} rel={rel} target={target} class={`${base} ${sizes[size]} ${variants[variant]} ${cls}`}>
  <slot name="icon" />
  <slot />
</a>
