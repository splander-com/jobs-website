---
/*
 * Mark + wordmark, both from the brand kit (03-marketing/logo/wordmark-*.svg):
 * "Splander Jobs" in Sora 800 with the coral bar under the "J". Ink on light,
 * white on chrome. `height` is the wordmark's rendered height in px.
 */
import Mark from "./Mark.astro";
import { withBase } from "../consts";

interface Props {
  height?: number;
  tone?: "dark" | "light";
  class?: string;
}
const { height = 22, tone = "dark", class: cls = "" } = Astro.props;
const width = Math.round((height * 640) / 110);
const file = tone === "light" ? "/brand/logo/wordmark-white.svg" : "/brand/logo/wordmark-dark.svg";
---

<span class={`inline-flex items-center gap-2 ${cls}`}>
  <Mark size={Math.round(height * 1.45)} />
  <img src={withBase(file)} width={width} height={height} alt="Splander Jobs" class="block" />
</span>
