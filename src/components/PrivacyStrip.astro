---
import { withBase } from "../consts";
const points = [
  { t: "Works without an account", d: "Start tracking the moment you install. Everything you track is saved on your own device." },
  { t: "Signing in is optional", d: "Sign in to turn on free cloud sync across your devices. You can turn sync off in Settings at any time." },
  { t: "Gmail is your choice", d: "You choose to connect it, and it's read-only. Emails are read on your device and never uploaded. If you sync, only the result syncs: company, title and status." },
  { t: "No ads, no selling", d: "We never sell or share your data, and there are no ad or tracking scripts." },
];
---
<div class="rounded-card border border-zinc-200 bg-white p-6 sm:p-8">
  <div class="flex items-center gap-2 text-coral-deep">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1 3 5v6c0 5 3.8 9.7 9 11 5.2-1.3 9-6 9-11V5l-9-4Zm-1 15-4-4 1.4-1.4L11 13.2l4.6-4.6L17 10l-6 6Z"/></svg>
    <span class="eyebrow">Private by default</span>
  </div>
  <h2 class="mt-3 font-display text-2xl font-extrabold text-zinc-900 sm:text-3xl">Free and private by default.</h2>
  <p class="mt-2 text-zinc-600">Your job search stays in your browser unless you sign in to sync.</p>
  <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      points.map((p) => (
        <div>
          <h3 class="font-semibold text-zinc-900">{p.t}</h3>
          <p class="mt-1 text-sm leading-relaxed text-zinc-600">{p.d}</p>
        </div>
      ))
    }
  </div>
  <a href={withBase("/privacy")} class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-coral-deep hover:underline">
    Read the privacy policy
    <svg width="16" height="16" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M7.3 4.3a1 1 0 0 1 1.4 0l5 5a1 1 0 0 1 0 1.4l-5 5a1 1 0 1 1-1.4-1.4L11.6 10 7.3 5.7a1 1 0 0 1 0-1.4Z" clip-rule="evenodd"/></svg>
  </a>
</div>
