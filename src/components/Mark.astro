---
/*
 * Splander Jobs mark: the brand kit's paper plane on its coral tile, used
 * as-is (never redrawn or recoloured). The face needs at least 48px, so smaller
 * sizes get the kit's plain plane (no face).
 */
import { withBase } from "../consts";

interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: cls = "" } = Astro.props;
const src = withBase(size >= 48 ? "/brand/icon.svg" : "/brand/icon-plain.svg");
---

<img src={src} width={size} height={size} alt="" aria-hidden="true" class={`block shrink-0 ${cls}`} />
