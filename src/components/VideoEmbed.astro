---
/*
 * Click-to-load video facade — renders only a poster + play button until the
 * user clicks, so no video bytes or player touch first paint (keeps LCP/TBT
 * green). Pass `youtube` (id) or `src` (self-hosted mp4) plus a `poster`.
 */
import { withBase } from "../consts";

interface Props {
  youtube?: string;
  src?: string;
  poster?: string;
  title?: string;
  ratio?: string;
  priority?: boolean;
  /** Visible button text, e.g. "Watch · 0:30". */
  label?: string;
}
const { youtube, src, poster, title = "Splander Jobs video", ratio = "16/9", priority = false, label = "Play video" } = Astro.props;
const videoSrc = src ? withBase(src) : undefined;
---

<div
  class="group relative overflow-hidden rounded-frame border border-white/10 bg-chrome shadow-frame"
  style={`aspect-ratio:${ratio}`}
  data-video-facade
  data-youtube={youtube}
  data-src={videoSrc}
  data-title={title}
>
  {
    poster && (
      <img
        src={withBase(poster)}
        alt=""
        width="1920"
        height="1080"
        loading={priority ? "eager" : "lazy"}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    )
  }
  <button
    type="button"
    class="absolute inset-0 flex items-end justify-start p-3 sm:p-4 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-action"
    aria-label={`Play ${title}`}
  >
    <span class="inline-flex items-center gap-2 rounded-full bg-action p-2.5 text-sm font-semibold text-ink shadow-frame transition-colors group-hover:bg-fold sm:py-2 sm:pl-3 sm:pr-4">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <span class="hidden sm:inline">{label}</span>
    </span>
  </button>
</div>

<script is:inline>
  document.querySelectorAll("[data-video-facade]").forEach((el) => {
    const btn = el.querySelector("button");
    if (!btn) return;
    btn.addEventListener("click", () => {
      const yt = el.getAttribute("data-youtube");
      const src = el.getAttribute("data-src");
      const title = el.getAttribute("data-title") || "";
      let node;
      if (yt) {
        node = document.createElement("iframe");
        node.src = "https://www.youtube-nocookie.com/embed/" + yt + "?autoplay=1";
        node.title = title;
        node.allow = "autoplay; encrypted-media; picture-in-picture";
        node.setAttribute("allowfullscreen", "");
      } else if (src) {
        node = document.createElement("video");
        node.src = src;
        node.controls = true;
        node.autoplay = true;
        node.playsInline = true;
        node.setAttribute("aria-label", title);
      } else return;
      node.className = "absolute inset-0 h-full w-full";
      el.replaceChildren(node);
      node.focus();
    });
  });
</script>
